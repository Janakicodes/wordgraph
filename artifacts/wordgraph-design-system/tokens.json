{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#FAFAF9" },
      "foreground": { "$value": "#18181B" },
      "border": { "$value": "#E4E4E7" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#18181B" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#18181B" },
      "primary": {
        "$value": "#18181B",
        "$description": "Neutral emphasis for actions, the center graph word, and primary text."
      },
      "primaryForeground": { "$value": "#FAFAF9" },
      "secondary": { "$value": "#F5F5F4" },
      "secondaryForeground": { "$value": "#18181B" },
      "muted": { "$value": "#F5F5F4" },
      "mutedForeground": { "$value": "#71717A" },
      "accent": { "$value": "#F4F4F5" },
      "accentForeground": { "$value": "#18181B" },
      "destructive": { "$value": "#B85C5C" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#E4E4E7" },
      "ring": { "$value": "#71717A" },
      "chart1": {
        "$value": "#4F8A68",
        "$description": "Synonym relationship: similar meaning."
      },
      "chart2": {
        "$value": "#B85C5C",
        "$description": "Antonym relationship: opposite meaning."
      },
      "chart3": {
        "$value": "#5B7FA3",
        "$description": "Related relationship: contextual connection."
      },
      "chart4": { "$value": "#A1A1AA" },
      "chart5": { "$value": "#D4D4D8" },
      "sidebar": { "$value": "#FAFAF9" },
      "sidebarForeground": { "$value": "#3F3F46" },
      "sidebarBorder": { "$value": "#E4E4E7" },
      "sidebarPrimary": { "$value": "#18181B" },
      "sidebarPrimaryForeground": { "$value": "#FAFAF9" },
      "sidebarAccent": { "$value": "#F1F1EF" },
      "sidebarAccentForeground": { "$value": "#18181B" },
      "sidebarRing": { "$value": "#71717A" }
    },
    "dark": {
      "background": { "$value": "#09090B" },
      "foreground": { "$value": "#FAFAFA" },
      "border": { "$value": "#27272A" },
      "card": { "$value": "#111113" },
      "cardForeground": { "$value": "#FAFAFA" },
      "popover": { "$value": "#111113" },
      "popoverForeground": { "$value": "#FAFAFA" },
      "primary": { "$value": "#FAFAFA" },
      "primaryForeground": { "$value": "#18181B" },
      "secondary": { "$value": "#18181B" },
      "secondaryForeground": { "$value": "#FAFAFA" },
      "muted": { "$value": "#18181B" },
      "mutedForeground": { "$value": "#A1A1AA" },
      "accent": { "$value": "#202023" },
      "accentForeground": { "$value": "#FAFAFA" },
      "destructive": { "$value": "#D47B7B" },
      "destructiveForeground": { "$value": "#18181B" },
      "input": { "$value": "#27272A" },
      "ring": { "$value": "#A1A1AA" },
      "chart1": {
        "$value": "#72A98A",
        "$description": "Synonym relationship: similar meaning."
      },
      "chart2": {
        "$value": "#D47B7B",
        "$description": "Antonym relationship: opposite meaning."
      },
      "chart3": {
        "$value": "#7EA1C4",
        "$description": "Related relationship: contextual connection."
      },
      "chart4": { "$value": "#71717A" },
      "chart5": { "$value": "#3F3F46" },
      "sidebar": { "$value": "#111113" },
      "sidebarForeground": { "$value": "#F4F4F5" },
      "sidebarBorder": { "$value": "#27272A" },
      "sidebarPrimary": { "$value": "#FAFAFA" },
      "sidebarPrimaryForeground": { "$value": "#18181B" },
      "sidebarAccent": { "$value": "#202023" },
      "sidebarAccentForeground": { "$value": "#FAFAFA" },
      "sidebarRing": { "$value": "#A1A1AA" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI, graph, and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base 8px corner radius; smaller and larger treatments derive from it."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base 4px spacing step; the product rhythm uses 4, 8, 12, 16, 24, 32, 48, 64, 80, and 96px."
    }
  }
}
